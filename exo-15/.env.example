# Copier en .env (non versionné) : cp .env.example .env
# Aucun secret ici : le mot de passe PostgreSQL est dans secrets/db_password.txt (make secrets).

# Base
POSTGRES_USER=shop
POSTGRES_DB=shop

# Prod : registre et version des images (TP03)
REGISTRY=localhost:5050
VERSION=1.4.2

# Dev : ports de debug publiés sur l'hôte
API_DEBUG_PORT=3000
DB_DEBUG_PORT=5432
TRAEFIK_DASHBOARD_PORT=8080
